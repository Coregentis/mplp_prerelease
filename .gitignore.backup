.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Build artifacts
/dist/
/build/
packages/sources/*/dist/
packages/sources/*/build/

# Publish Sources (Must include dist for re-publishing)
!packages/npm/*/dist/


# Docusaurus build and cache
docs/.docusaurus/
docs/build/
docs/node_modules/

# Documentation temporary and backup files
docs/.cache/
docs/*-backup*/
docs/*-corrupted/
docs/build-*.txt
docs/*.ps1

# Internal process files and scripts
fix-*.ps1
*.ps1

# Backup and internal directories (anywhere)
*-backup*/
*-internal/
*-draft/
*-corrupted/

# Debug and development scripts
scripts/debug-*.ts
scripts/release-*.mjs

# Test output and temporary files
*-test-result.txt
test-*.txt
*_output.txt
pnpm-test-result.txt

# Lock files that may contain local paths
package-lock.json

# Antigravity/Agent artifacts
.agent/
.antigravityignore

